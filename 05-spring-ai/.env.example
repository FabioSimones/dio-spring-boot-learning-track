# Documentation only (TASK-012) - the application does NOT load this file
# automatically (no dotenv support is configured). Copy the variables you need
# into your shell/IDE run configuration/CI secret store; never fill in real
# values here and commit them.
#
# Selects which application-<profile>.properties file is loaded in addition
# to the common application.properties. Leave unset to run with just the
# common file (no OpenAI key, no datasource - see README).
SPRING_PROFILES_ACTIVE=dev

# Required when SPRING_PROFILES_ACTIVE=dev or prod. Not needed if you run
# `docker compose up` and skip SPRING_PROFILES_ACTIVE entirely - Spring Boot's
# docker-compose support wires these for you in that case.
DB_URL=jdbc:mysql://localhost:3306/budgeting
DB_USERNAME=root
DB_PASSWORD=troque-este-valor

# Required when SPRING_PROFILES_ACTIVE=dev or prod. Never a real key here -
# revoke immediately any key that was ever committed anywhere.
OPENAI_API_KEY=configure-sua-chave

# Optional operational overrides - all have safe defaults in application.properties.
# AUDIO_MAX_SIZE=10MB
# AI_CONNECT_TIMEOUT=10s
# AI_READ_TIMEOUT=60s
# AI_RETRY_MAX_ATTEMPTS=2
# IDEMPOTENCY_COMPLETED_RETENTION=24h
# IDEMPOTENCY_FAILED_RETENTION=24h
# IDEMPOTENCY_PROCESSING_TIMEOUT=15m
# IDEMPOTENCY_CLEANUP_ENABLED=true
